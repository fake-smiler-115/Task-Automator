  "function": "send_message",
  "requires_confirmation": true,
  "parameters": {
    "type": "object",
    "properties": {
      "contact_name": {
        "type": "string",
        "description": "The WhatsApp contact name"
      },
      "message": {
        "type": "string",
        "description": "The message to send"
      }
    },
